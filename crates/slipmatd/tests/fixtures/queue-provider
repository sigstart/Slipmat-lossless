set -eu
IFS= read -r frame
[ "$frame" = '{"type":"begin"}' ]
printf '%s\n' '{"type":"credentialsRequired"}'
IFS= read -r frame
[ "$frame" = '{"type":"credentials","account":"test@example.invalid","password":"fixture-password"}' ]
printf '%s\n' '{"type":"signedIn","catalogue":{"developerToken":"fixture-developer","musicUserToken":"fixture-user","storefront":"us","authorized":true}}'
duplicate_plays=0
while IFS= read -r frame; do
    case "$frame" in
        '{"type":"playTrack","track_id":"111"}')
            printf '%s\n' '{"type":"playing"}' '{"type":"position","position_ms":1250}'
            ;;
        '{"type":"playTrack","track_id":"222"}')
            printf '%s\n' '{"type":"playing"}' '{"type":"played","sample_rate":44100,"bits_per_sample":16,"channels":2}'
            ;;
        '{"type":"playTrack","track_id":"333"}')
            printf '%s\n' '{"type":"playing"}' '{"type":"position","position_ms":2300}'
            ;;
        '{"type":"playTrack","track_id":"444"}')
            duplicate_plays=$((duplicate_plays + 1))
            printf '%s\n' '{"type":"playing"}'
            if [ "$duplicate_plays" -eq 1 ]; then
                printf '%s\n' '{"type":"position","position_ms":3600}'
            else
                printf '%s\n' '{"type":"position","position_ms":400}'
            fi
            ;;
        '{"type":"pause"}') printf '%s\n' '{"type":"paused"}' ;;
        '{"type":"resume"}')
            printf '%s\n' '{"type":"playing"}'
            if [ "$duplicate_plays" -eq 1 ]; then
                printf '%s\n' '{"type":"played","sample_rate":44100,"bits_per_sample":16,"channels":2}'
            fi
            ;;
        '{"type":"stop"}') printf '%s\n' '{"type":"stopped"}' ;;
        *) exit 1 ;;
    esac
done
